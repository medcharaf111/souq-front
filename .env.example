# Public URL of the souq backend (Express). The frontend calls it directly from
# both server components (SSR) and the browser (client components for sync triggers).
#
# In dev: http://localhost:3000   (souq's default port)
# In prod: https://api.your-domain.com   (your deployed backend)
NEXT_PUBLIC_API_URL=http://localhost:3000

# Which Salla merchant this frontend deployment is branded for.
# Set this PER-DEPLOYMENT — one Vercel project / one Android build per merchant,
# each with its own store_id. The whole frontend is scoped to one merchant.
# Copy the Store ID from the admin page (/admin) of the souq backend after that
# merchant has installed the partner app.
NEXT_PUBLIC_STORE_ID=
